generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model clientes {
  id              Int       @id @default(autoincrement())
  nome            String    @db.VarChar(100)
  data_nascimento DateTime  @db.Date
  pedidos         pedidos[]
}

model comentarios {
  id            Int       @id @default(autoincrement())
  texto         String
  tarefas_id    Int
  usuario_id    Int
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  atualizado_em DateTime? @default(now()) @db.Timestamp(6)
  tarefas       tarefas   @relation(fields: [tarefas_id], references: [id], onDelete: Cascade)
  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model pedidos {
  id           Int            @id @default(autoincrement())
  data         DateTime?      @db.Timestamp(6)
  idcliente    Int
  clientes     clientes       @relation(fields: [idcliente], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pedidositens pedidositens[]
}

model pedidositens {
  id         Int      @id @default(autoincrement())
  idpedido   Int
  idproduto  Int
  valor      Decimal  @db.Decimal(18, 2)
  desconto   Decimal  @db.Decimal(18, 2)
  quantidade Decimal  @db.Decimal(18, 2)
  pedidos    pedidos  @relation(fields: [idpedido], references: [id], onDelete: NoAction, onUpdate: NoAction)
  produtos   produtos @relation(fields: [idproduto], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model prioridade {
  id        Int       @id @default(autoincrement())
  descricao String?
  criado_em DateTime? @default(now()) @db.Timestamp(6)
  ativo     Boolean?
  tarefas   tarefas[]
}

model produtos {
  id                 Int              @id @default(autoincrement())
  descricao          String?          @db.VarChar(100)
  id_unidadedemedida Int
  pedidositens       pedidositens[]
  unidadesdemedida   unidadesdemedida @relation(fields: [id_unidadedemedida], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model projetos {
  id            Int       @id @default(autoincrement())
  nome          String    @db.VarChar(100)
  descricao     String?
  usuario_id    Int
  criado_em     DateTime? @default(now()) @db.Timestamp(6)
  atualizado_em DateTime? @default(now()) @db.Timestamp(6)
  usuarios      usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tarefas       tarefas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tarefas {
  id            Int           @id @default(autoincrement())
  texto         String
  coluna        String        @default("afazer") @db.VarChar(10)
  ordem         Int           @default(0)
  projeto_id    Int
  usuario_id    Int
  criado_em     DateTime?     @default(now()) @db.Timestamp(6)
  iniciada_em   DateTime?     @db.Timestamp(6)
  concluida_em  DateTime?     @db.Timestamp(6)
  prioridade_id Int?
  atualizado_em DateTime?     @default(now()) @db.Timestamp(6)
  comentarios   comentarios[]
  prioridade    prioridade?   @relation(fields: [prioridade_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "tarefas_prioridade_fk")
  projetos      projetos      @relation(fields: [projeto_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  usuarios      usuarios      @relation(fields: [usuario_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model teste {
  id          Int           @id @default(autoincrement())
  nome        String        @db.VarChar(100)
  descricao   String?       @db.VarChar(1000)
  teste_filha teste_filha[]
}

model teste_filha {
  id         Int      @id @default(autoincrement())
  id_teste   Int?
  quantidade Decimal? @db.Decimal(10, 2)
  teste      teste?   @relation(fields: [id_teste], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model unidadesdemedida {
  id        Int        @id @default(autoincrement())
  sigla     String     @db.VarChar(3)
  descricao String?    @db.VarChar(30)
  produtos  produtos[]
}

model usuarios {
  id            Int           @id @default(autoincrement())
  nome          String        @db.VarChar(100)
  email         String        @unique @db.VarChar(100)
  senha_hash    String        @db.VarChar(255)
  criado_em     DateTime?     @default(now()) @db.Timestamp(6)
  atualizado_em DateTime?     @default(now()) @db.Timestamp(6)
  comentarios   comentarios[]
  projetos      projetos[]
  tarefas       tarefas[]
}
